# =============================================================================
# Run tests — required to clone and run Playwright (`npx playwright test`)
# =============================================================================

# Didaxis Studio base URL (no trailing slash)
DIDAXIS_URL=https://test.didaxis.studio

# Admin UI login used by auth.setup → storageState
DIDAXIS_EMAIL=you@example.com

# Admin UI password (never commit the real value)
DIDAXIS_PASSWORD=replace-me

# Bearer token for GET/DELETE /api/programs (cleanup + API seeding)
DIDAXIS_API_TOKEN=replace-me

# Optional — non-admin account for permission-probe tests.
# Specs currently read DIDAXIS_NONADMIN_EMAIL / DIDAXIS_NONADMIN_PASSWORD;
# set those to the same values (or alias them in your shell).
DIDAXIS_ALT_EMAIL=nonadmin@example.com
DIDAXIS_ALT_PASSWORD=replace-me
DIDAXIS_NONADMIN_EMAIL=nonadmin@example.com
DIDAXIS_NONADMIN_PASSWORD=replace-me

# =============================================================================
# Agent / CI setup — not needed for `npx playwright test` alone
# =============================================================================

# Cursor headless agent API key (.github/workflows/test-generation.yml)
CURSOR_API_KEY=replace-me

# Atlassian / Jira API token (headless agent + Jira MCP in Cursor settings)
ATLASSIAN_API_TOKEN=replace-me

# Jira site base URL, e.g. https://your-org.atlassian.net
ATLASSIAN_BASE_URL=https://your-org.atlassian.net

# Atlassian account email paired with ATLASSIAN_API_TOKEN
ATLASSIAN_EMAIL=you@example.com
